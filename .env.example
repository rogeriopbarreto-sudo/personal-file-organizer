# Google Drive API (JSON completo do service account)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# IDs das pastas do Drive (copiar da URL: /folders/ID)
DRIVE_FOLDER_01=1npTOEhS6arf-j717zvewL2qTfAYsE84R
DRIVE_FOLDER_02=1fOHjH9qp2yAIaGjshv7ghIpOVZk8Fmet
DRIVE_FOLDER_03=1iJXrUMfLG4g32wLJSX7SV2acTKiTdYMx
DRIVE_FOLDER_04=1w_1WNm0F_asyL9KNhe6D7SbEOGQGuSdd
# As subpastas de banco da Pasta 04 (BTG, Itau) são descobertas sozinhas.

# Webhook do Drive — PRECISA ser https e acessível da internet
WEBHOOK_BASE_URL=https://organizer.barreto.ai
WEBHOOK_TOKEN=
# Segundos de espera para agrupar a rajada de notificações de um mesmo upload
WEBHOOK_DEBOUNCE_SECONDS=3

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic — último recurso quando o parser determinístico não fecha
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
USAR_LLM_FALLBACK=true

# Modo seco: loga o que faria, sem renomear nada
DRY_RUN=true

# Volume persistente com o cache de arquivos já processados
STATE_DIR=/app/state

# DEBUG para investigar parsing
LOG_LEVEL=INFO
